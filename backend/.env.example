# ── Application ────────────────────────────────────────────────────────────
APP_NAME=Exam Paper Maker & Moderation Portal

# ── Security (CHANGE THESE IN PRODUCTION) ──────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string-at-least-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ────────────────────────────────────────────────────────────────
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP (no root password):   mysql+pymysql://root:@localhost:3306/exam_portal
# MySQL with password:         mysql+pymysql://root:yourpassword@localhost:3306/exam_portal
DATABASE_URL=mysql+pymysql://root:@localhost:3306/exam_portal

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── File Upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Seed (used by seed.py) ──────────────────────────────────────────────────
OWNER_EMAIL=admin@portal.edu
OWNER_PASSWORD=Admin@1234
